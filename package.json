{
  "name": "klimaticket_rechner",
  "version": "1.0.0",
  "description": "A complete web app to track trips, calculate costs, and visualize statistics for the Austrian Klimaticket.",
  "scripts": {
    "dev": "python3 -m http.server 8000",
    "serve": "python3 -m http.server 8000",
    "build": "node scripts/build-ios-web.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage --run",
    "test:coverage:report": "vitest --coverage --run && open coverage/index.html",
    "check:i18n": "node scripts/check-i18n.js",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhoelzl/klimaticket-rechner.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jhoelzl/klimaticket-rechner/issues"
  },
  "homepage": "https://github.com/jhoelzl/klimaticket-rechner#readme",
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "jsdom": "^27.4.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2"
  }
}
